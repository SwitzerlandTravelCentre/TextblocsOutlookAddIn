{
  "name": "textblocsfit-outlook-addin",
  "version": "0.1.0",
  "private": true,
  "description": "Outlook task pane add-in for STC multilingual email text blocks.",
  "scripts": {
    "certs:install": "office-addin-dev-certs install",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "convert:textblocks": "python tools/convert-xlsx-to-json-runner.txt"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/office-js": "^1.0.471",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "office-addin-dev-certs": "^2.0.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
